<launch>
  <arg name="robot_name"/>
  <arg name="init_pose"/>
  <arg name="model" default="$(find drone)/urdf/drone.sdf"/>

  <param name="robot_description" command="$(find xacro)/xacro $(arg model)" />

  <node name="sdf_spawner" pkg="gazebo_ros" type="spawn_model"
        args="$(arg init_pose) -unpause -sdf -model $(arg robot_name) -param robot_description" respawn="false" output="screen" />

</launch>