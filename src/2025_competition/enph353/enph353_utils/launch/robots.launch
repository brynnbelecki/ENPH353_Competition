<!-- Launch new Robbie URDF 
	<group ns="B1">
		<param name="tf_prefix" value="B1_tf" />
		<include file="$(find robbie)/launch/robbie.launch">
			<arg name="init_pose" value="-x 5.5 -y 2.5 -z 0.2 -R 0.0 -P 0.0 -Y -1.57" />
			<arg name="robot_name"  value="B1" />
		</include>
		<Add teleop_keyboard controller>
		<include file="$(find enph353_utils)/launch/desktop.launch"/>
	</group> -->
	<group ns="D1">
		<param name="tf_prefix" value="D1_tf"/>
		<include file="$(find drone)/launch/drone.launch">
			<arg name="init_pose" value="-x 5.5 -y 2.5 -z 0.1 -R 0.0 -P 0.0 -Y -1.57" />
			<arg name="robot_name"  value="D1" />
		</include>
	</group>
	<group ns="D2">
		<param name="tf_prefix" value="D2_tf"/>
		<include file="$(find drone)/launch/drone2.launch">
			<arg name="init_pose" value="-x 5.5 -y 2 -z 0.1 -R 0.0 -P 0.0 -Y -1.256" />
			<arg name="robot_name"  value="D2" />
		</include>
	</group>
</launch>
